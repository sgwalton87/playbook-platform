# Playbook deployment identity
PLAYBOOK_DEPLOYMENT_ENV=local
PLAYBOOK_APP_URL=http://localhost:3000
PLAYBOOK_BETA_EXPOSURE_MODE=off
PLAYBOOK_BETA_REQUIRE_ACCESS_GRANT=false
PLAYBOOK_RELEASE=local-development

# Server-only operational telemetry access. Rotate independently of application
# credentials and never expose it through NEXT_PUBLIC_ variables.
PLAYBOOK_OBSERVABILITY_SECRET=replace-with-observability-secret

# Required Supabase browser/server session boundary (public project values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key

# Server-only Supabase administration. Required only by audited administrative,
# webhook, and integration operations. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Human-verification client configuration
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=replace-with-hcaptcha-site-key

# Inbound mail gateway authentication (server only)
MAIL_GATEWAY_SECRET=replace-with-random-webhook-secret

# Transactional email providers (server only; configure the provider in use)
RESEND_API_KEY=replace-with-resend-api-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
PLAYBOOK_EMAIL_HELLO=hello@example.com
PLAYBOOK_EMAIL_NOREPLY=noreply@example.com
PLAYBOOK_EMAIL_NOTIFICATIONS=notifications@example.com
PLAYBOOK_EMAIL_ONBOARDING=onboarding@example.com
PLAYBOOK_EMAIL_SUPPORT=support@example.com
PLAYBOOK_ADMIN_NOTIFICATION_EMAIL=security-review@example.com

# Optional governed AI providers (server only)
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ZAI_API_KEY=replace-with-zai-api-key

# Optional public college data provider
NEXT_PUBLIC_COLLEGE_SCORECARD_API_KEY=replace-with-college-scorecard-key

# Isolated test environment only; never point these at production
SUPABASE_TEST_URL=https://your-test-project.supabase.co
SUPABASE_TEST_ANON_KEY=replace-with-test-project-anon-key
SUPABASE_TEST_SERVICE_ROLE_KEY=replace-with-test-project-service-role-key
TEST_SCHOLAR_EMAIL=scholar-test@example.com
TEST_SCHOLAR_PASSWORD=replace-with-test-password
