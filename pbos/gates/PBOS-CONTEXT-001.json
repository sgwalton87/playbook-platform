{
  "id": "PBOS-CONTEXT-001",
  "title": "Repository Context Verification",
  "version": "1.0.0",
  "objective": "Verify repository identity, branch, commit, active gate, required artifacts, and runtime state before PBOS execution.",
  "allowedFiles": [
    "pbos/context/**",
    "pbos/runtime/**",
    "docs/**"
  ],
  "blockedFiles": [
    ".env",
    "supabase/migrations/**",
    "app/**"
  ],
  "allowedOperations": [
    "CREATE_FILE",
    "UPDATE_FILE",
    "RUN_VALIDATION",
    "GENERATE_EVIDENCE"
  ],
  "requiredValidation": [
    "pbos:test",
    "pbos:lint"
  ],
  "evidenceRequirements": [
    "context-report",
    "validation-results",
    "change-summary"
  ]
}
